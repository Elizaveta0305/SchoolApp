<UserControl x:Class="SchoolApplication.Views.UserControls.StudentUC.Lessons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:SchoolApplication.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1090"
             Background="Transparent"
             d:DataContext="{d:DesignInstance vm:LessonsVm}">
    <Grid>
        <materialDesign:Card Margin="20" 
                             Background="White"
                             UniformCornerRadius="15">
            <Grid>
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Занятия"
                                   FontWeight="Bold"
                                   Margin="20 40"
                                   FontSize="40"/>
                    </DockPanel>
                    <materialDesign:ColorZone Mode="Custom"
                                              Background="MistyRose"
                                              Foreground="LightSalmon"
                                              CornerRadius="15"
                                              Padding="40 15"
                                              Width="998"
                                              HorizontalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Учение - труд!"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="0 15 0 0"/>
                                <TextBlock Text="Быстрых результатов не бывает!"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Left"
                                           Foreground="SlateGray"
                                           VerticalAlignment="Center"
                                           Margin="0 5 0 0"/>
                                <TextBlock Text="У тебя все получится!"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Left"
                                           Foreground="SlateGray"
                                           VerticalAlignment="Center"
                                           Margin="0 5 0 0"/>
                            </StackPanel>
                            <Image Source="/Images/LessonImg.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Height="200"
                                   Width="290"
                                   Margin="0 -85 0 -1"
                                   />
                        </Grid>
                    </materialDesign:ColorZone>

                    <DataGrid ItemsSource="{Binding AllStudentLessons}" 
                              IsReadOnly="True"
                              AutoGenerateColumns="False"               
                              Height="400"
                              Width="998"
                              BorderThickness="2"
                              VerticalAlignment="Center"
                              Margin="0 20 0 0"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              HeadersVisibility="Column"
                              RowBackground="{DynamicResource MaterialDesignPaper}"
                              AlternatingRowBackground="{DynamicResource MaterialDesignBackground}"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" 
                                                Binding="{Binding FormattedLessonDate}" 
                                                IsReadOnly="True"
                                                Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Время" 
                                                Binding="{Binding FormattedLessonTime}" 
                                                IsReadOnly="True"
                                                Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Предмет" 
                                                Binding="{Binding SubjectName}" 
                                                IsReadOnly="True"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="5"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Преподаватель" 
                                                Binding="{Binding TeacherFullName}" 
                                                IsReadOnly="True"
                                                Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Кабинет" 
                                                Binding="{Binding RoomNumber}" 
                                                IsReadOnly="True"
                                                Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
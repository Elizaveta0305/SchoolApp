<UserControl x:Class="SchoolApplication.Views.UserControls.StudentUC.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:studentUC="clr-namespace:SchoolApplication.Views.UserControls.StudentUC"
             xmlns:vm="clr-namespace:SchoolApplication.ViewModels"
             xmlns:models="clr-namespace:SchoolApplication.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1090"
             Background="Transparent">

    <materialDesign:Card Margin="20"
                         Background="White"
                         UniformCornerRadius="15"
                         BorderThickness="0">
        <StackPanel Margin="30 12 30 0">
            <DockPanel Margin="0 12 5 0">
                <TextBlock Text="Добро пожаловать!"
                           HorizontalAlignment="Left"
                           FontSize="45"
                           FontWeight="Bold"/>
            </DockPanel>
            <materialDesign:ColorZone Mode="Custom"
                                      Background="MistyRose"
                                      Foreground="LightSalmon"
                                      CornerRadius="15"
                                      Padding="40 15"
                                      Margin="0 35 0 0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding WelcomeMessage}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="0 15 0 0"/>
                        <TextBlock Text="Необходимо работать, чтобы быть успешным!"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Left"
                                   Foreground="SlateGray"
                                   VerticalAlignment="Center"
                                   Margin="0 5 0 0"/>
                        <TextBlock Text="Продолжайте в том же духе, и у вас все обязательно получится!"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Left"
                                   Foreground="SlateGray"
                                   VerticalAlignment="Center"
                                   Margin="0 5 0 0"/>
                    </StackPanel>
                    <Image Source="/Images/HomeSt.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Grid.Column="1"
                           HorizontalAlignment="Right"
                           Height="200"
                           Width="290"
                           Margin="0 -85 0 -1"
                           />
                </Grid>
            </materialDesign:ColorZone>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:ColorZone Grid.Column="0"
                                          Mode="Custom"
                                          Background="White"
                                          Foreground="Black"
                                          CornerRadius="15"
                                          Padding="20"
                                          Width="640"
                                          Height="369">
                    <StackPanel>
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock Text="Ближайшие занятия"
                                       FontWeight="Bold"
                                       FontSize="15"/>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding UpcomingLessons}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  CanUserResizeColumns="False"
                                  HeadersVisibility="None"
                                  GridLinesVisibility="None"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="White"
                                  BorderThickness="0"
                                  Margin="0 15 0 0"
                                  Height="280">

                            <DataGrid.Resources>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding FormattedLessonDate}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Height" Value="45"/>
                                            <Setter Property="Margin" Value="0 0 5 0"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding FormattedLessonTime}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Margin" Value="0 0 10 0"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding SubjectName}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="Margin" Value="0 0 5 0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding TeacherFullName}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding RoomNumber}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:ColorZone>

                <materialDesign:ColorZone Grid.Column="1"
                                          Mode="Custom"
                                          Background="White"
                                          Foreground="Black"
                                          CornerRadius="15"
                                          Padding="20"
                                          Height="340"
                                          Margin="20 0 0 0">
                    <StackPanel>
                        <TextBlock Text="Аналитика"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <StackPanel Margin="0 10 0 0">
                            <TextBlock Text="Количество пропусков"/>
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <ProgressBar Height="10"
                                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                                             Width="290" Maximum="{x:Static vm:HomeVm.MaxAbsencesValue}" Value="{Binding AbsencesCount}"/>
                                <TextBlock Text="{Binding AbsencesDisplayText}"
                                           Margin="10 0 0 0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0 20 0 0">
                            <TextBlock Text="Количество изучаемых предметов"/>
                            <TextBlock Text="{Binding SubjectsCount}"
                                       FontSize="30"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Margin="0 10 0 0">
                            <TextBlock Text="Успеваемость"/>
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <ProgressBar Height="10"
                                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                                             Width="290" Maximum="5" Value="{Binding AverageGradeValue}"/>
                                <TextBlock Text="{Binding AverageGradeDisplayText}"
                                           Margin="10 0 0 0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        
                    </StackPanel>
                </materialDesign:ColorZone>

                <materialDesign:ColorZone Mode="Custom"
                                          Background="Gainsboro"
                                          Foreground="Firebrick"
                                          CornerRadius="15"
                                          Padding="40 15"
                                          Grid.ColumnSpan="2" Margin="0,368,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="460"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Следите за обновлениями в расписании!"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Иногда преподаватели не могут сказать точно, когда будет пара"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Left"
                                       Foreground="Black"
                                       VerticalAlignment="Center"
                                       Margin="0 5 0 0"/>
                            <TextBlock Text="Следите за кабинетами, они имеют свойства меняться :))"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Left"
                                       Foreground="Black"
                                       VerticalAlignment="Center"
                                       Margin="0 5 0 0"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:ColorZone>

            </Grid>
        </StackPanel>

    </materialDesign:Card>
</UserControl>
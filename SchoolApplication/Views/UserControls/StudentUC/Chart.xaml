<UserControl x:Class="SchoolApplication.Views.UserControls.StudentUC.Chart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF" 
             xmlns:vm="clr-namespace:SchoolApplication.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="300"
             >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>

        <scottPlot:WpfPlot x:Name="GaugePlot" 
                           Grid.Row="0" Grid.Column="0" Margin="5" />

        <TextBlock Text="{Binding GaugeValue, StringFormat={}{0:N0}}" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="Black"/>
    </Grid>
</UserControl>
<UserControl x:Class="SchoolApplication.Views.UserControls.TeacherUC.LessonTeacherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SchoolApplication.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1090"
             Background="Transparent">
    <Grid>
        <materialDesign:Card Margin="20"
                             Background="White"
                             UniformCornerRadius="15">
            <Grid>
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Занятия"
                                   FontWeight="Bold"
                                   Margin="20 30"
                                   FontSize="40"/>
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding LessonsCollection, Mode=TwoWay}"
                              Height="370"
                              Width="998"
                              BorderThickness="1"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              HeadersVisibility="Column"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="10 5"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="90" CanUserSort="True"/>
                            <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="180" CanUserSort="True"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding LessonDate, StringFormat='dd.MM.yyyy'}" Width="100" CanUserSort="True"/>
                            <DataGridTextColumn Header="Время" Binding="{Binding LessonTime, StringFormat='hh\\:mm'}" Width="100" CanUserSort="True"/>
                            <DataGridTextColumn Header="Тема занятия" Binding="{Binding Topic}" Width="300" CanUserSort="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Topic}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Кабинет" Binding="{Binding ClassroomNumber}" Width="Auto" CanUserSort="True"/>
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    ToolTip="Редактировать занятие"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.EditLessonCommand}"
                                                    CommandParameter="{Binding}"
                                                    Margin="2">
                                                <materialDesign:PackIcon Kind="Pencil" Foreground="{StaticResource MaterialDesign.Brush.Primary}" Width="15" Height="15"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    ToolTip="Удалить занятие"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.DeleteLessonCommand}"
                                                    CommandParameter="{Binding}"
                                                    Margin="2">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="{StaticResource MaterialDesign.Brush.ValidationError}" Width="15" Height="15"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Действия с занятиями"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="26 20 26 0"/>

                    <WrapPanel Width="998" Margin="20" HorizontalAlignment="Center">

                        <StackPanel Margin="0 0 10 0">
                            <TextBlock Text="Группа" FontSize="18"/>
                            <ComboBox ItemsSource="{Binding Groups}"
                                      DisplayMemberPath="GroupName"
                                      SelectedItem="{Binding SelectedGroup}"
                                      Width="180" Height="36"
                                      materialDesign:HintAssist.Hint="Выберите группу"/>
                        </StackPanel>

                        <StackPanel Margin="0 0 10 0">
                            <TextBlock Text="Предмет" FontSize="18"/>
                            <ComboBox ItemsSource="{Binding Subjects}"
                                      DisplayMemberPath="SubjectName"
                                      SelectedItem="{Binding SelectedSubject}"
                                      Width="180" Height="36"
                                      materialDesign:HintAssist.Hint="Выберите предмет"/>
                        </StackPanel>

                        <StackPanel Margin="0 0 10 0">
                            <TextBlock Text="Дата" FontSize="18"/>
                            <DatePicker SelectedDate="{Binding SelectedDate}"
                                        Width="180" Height="36"
                                        materialDesign:HintAssist.Hint="Выберите дату"/>
                        </StackPanel>

                        <StackPanel Margin="0 0 10 0">
                            <TextBlock Text="Время (чч:мм)" FontSize="18"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding SelectedHour, StringFormat=D2, UpdateSourceTrigger=PropertyChanged}"
                                         Width="85" Height="36" HorizontalContentAlignment="Center"
                                         materialDesign:HintAssist.Hint="Часы"
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         PreviewTextInput="NumberValidationTextBox"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="5 0"/>
                                <TextBox Text="{Binding SelectedMinute, StringFormat=D2, UpdateSourceTrigger=PropertyChanged}"
                                         Width="85" Height="36" HorizontalContentAlignment="Center"
                                         materialDesign:HintAssist.Hint="Минуты"
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         PreviewTextInput="NumberValidationTextBox"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0 0 10 0">
                            <TextBlock Text="Кабинет" FontSize="18"/>
                            <ComboBox ItemsSource="{Binding Classrooms}"
                                      DisplayMemberPath="RoomNumber"
                                      SelectedItem="{Binding SelectedClassroom}"
                                      Width="180" Height="36"
                                      materialDesign:HintAssist.Hint="Выберите кабинет"/>
                        </StackPanel>

                        <StackPanel Margin="0 20 10 0">
                            <TextBlock Text="Название темы" FontSize="18"/>
                            <TextBox Text="{Binding LessonTopicInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Введите тему занятия"
                                     Width="180" Height="36"
                                     VerticalContentAlignment="Center"
                                     materialDesign:TextFieldAssist.HasClearButton="True"/>
                        </StackPanel>

                        <StackPanel Margin="0 20 10 0">
                            <TextBlock Text="Действие" FontSize="18"/>
                            <ComboBox ItemsSource="{Binding ActionTypes}"
                                      SelectedItem="{Binding SelectedActionType}"
                                      Width="180" Height="36"
                                      materialDesign:HintAssist.Hint="Выберите действие"/>
                        </StackPanel>

                        <StackPanel Margin="0 20 0 0" VerticalAlignment="Bottom">
                            <Button Width="180" Height="36" Content="Выполнить"
                                    Command="{Binding PerformLessonActionCommand}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
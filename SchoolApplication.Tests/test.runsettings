<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat Code Coverage" uri="ms-dotnet-ohe/Microsoft.TestPlatform.Extensions.Coverlet.Collector/v1.0" assemblyQualifiedName="Microsoft.TestPlatform.Extensions.Coverlet.Collector.CoverletCodeCoverageDataCollector, Microsoft.TestPlatform.Extensions.Coverlet.Collector, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null">
                <Configuration>
                    <Format>cobertura</Format>
                    <ExcludeByFile>$(MSBuildProjectDirectory)/**/*.Designer.cs,$(MSBuildProjectDirectory)/**/*Migrations.cs,$(MSBuildProjectDirectory)/**/*.g.cs,$(MSBuildProjectDirectory)/**/*Tests.cs</ExcludeByFile>
                    <ExcludeByAttribute>System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
                    <IncludeTestAssembly>false</IncludeTestAssembly>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>
